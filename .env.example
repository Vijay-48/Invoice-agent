DATABASE_URL=postgresql+psycopg://ap:ap@localhost:5432/ap
STORAGE_DIR=./storage
EXCEL_PATH=./output/invoices.xlsx
# One workbook per financial year: output/invoices FY2026-27.xlsx (false = the single file above)
EXCEL_PER_FINANCIAL_YEAR=true

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Your company's GSTIN (the buyer on supplier invoices); leave empty to skip the check
COMPANY_GSTIN=36AABCT1234F1ZR
# Invoices that pass every check go straight to Excel up to this amount
AUTO_APPROVE_LIMIT=50000
MIN_CONFIDENCE=0.85

# Gmail through Composio (dashboard.composio.dev -> Platform -> API key)
COMPOSIO_API_KEY=ak_...
# Inbox + Spam + archived mail (not sent mail, drafts, trash); emails with attachments or
# mentioning invoice/bill/GSTIN ({...} = OR), so invoices written in the body are found too
GMAIL_QUERY=in:anywhere -in:sent -in:drafts -in:trash {has:attachment invoice bill gstin}
GMAIL_POLL_MINUTES=1
# Optional: only emails whose subject/body contains one of these words
GMAIL_SUBJECT_KEYWORDS=
# Where the browser returns after connecting Gmail (activation is automatic)
PUBLIC_BASE_URL=http://localhost:8000

# INFO = one line per step; DEBUG = every check and Composio call
LOG_LEVEL=INFO

# Gmail extras
GMAIL_READ_BODY_INVOICES=true
GMAIL_APPLY_LABELS=true
GMAIL_LABEL_PREFIX=AP
GMAIL_RECONCILE_DAYS=7
# Passwords tried on protected PDFs (comma-separated); passwords entered in the app are remembered too
PDF_PASSWORDS=

# AI assistant (chat)
ASSISTANT_MODEL=gpt-4o
EXPORT_DIR=./output/exports

# Summary report by email, sent from a connected Gmail (off | daily | weekly | monthly)
REPORT_SCHEDULE=off
REPORT_TIME=09:00
REPORT_WEEKDAY=mon
# Comma-separated; empty = every user's email
REPORT_RECIPIENTS=
# Whose Gmail sends it; 0 = the first user with Gmail connected
REPORT_SENDER_USER_ID=0
# The frontend's address, for clickable invoice links in the email (e.g. http://localhost:5173)
REPORT_APP_URL=

# Gmail: how new-email events arrive. websocket = no public URL needed (one PC);
# webhook = production: Composio POSTs to PUBLIC_BASE_URL/webhooks/composio, signed with the secret
GMAIL_DELIVERY=websocket
COMPOSIO_WEBHOOK_SECRET=
# Invoices sent as download links: allowed domains (comma-separated, https only); empty = off
GMAIL_LINK_DOMAINS=
# Email a user once when their Gmail access expires (sent from another connected inbox)
GMAIL_HEALTH_ALERTS=false

# Reading accuracy (Phase 2)
# Checks failed -> read once more by this model, told what failed
AI_SECOND_PASS=true
AI_SECOND_PASS_MODEL=gpt-4o
# GST e-invoice QR: exact values from the signed QR; folder with NIC's public key (*.pem) to verify it
EINVOICE_QR=true
EINVOICE_KEYS_DIR=

# Many users at once
WORKER_CONCURRENCY=4
GMAIL_CONCURRENCY=4
API_THREADS=100
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
